NODE_ENV=development
PORT=4000

# Neon connection string. Use the POOLED endpoint — the host contains "-pooler".
# `neon init` writes the real value into .env (which is gitignored).
DATABASE_URL=

# Session signing secret. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public origin of THIS api, used to build auth callback URLs.
BETTER_AUTH_URL=http://localhost:4000

# Browser origins allowed to call this API. Comma-separated. In production this must
# be the deployed frontend's own origin (e.g. https://kelola-app.vercel.app) — the
# server refuses to boot if it still points at localhost.
CORS_ORIGIN=http://localhost:3000

# Shared parent domain for the session cookie, e.g. ".kelola.app". Set this ONLY
# once the app and the API live on subdomains of one domain you own; the cookie is
# then same-site and uses SameSite=Lax.
#
# Leave it UNSET on Vercel + Railway. Those are different registrable domains, so
# the cookie must go out as SameSite=None, which the code selects automatically from
# this variable being empty. Do not put ".vercel.app" here — it is on the Public
# Suffix List and browsers reject it as a cookie domain.
COOKIE_DOMAIN=

# Gemini key for the AI channel, from https://aistudio.google.com/apikey
# Belongs here only — never in kelola-app, and never behind a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Model id. gemini-2.0-flash was SHUT DOWN on 2026-06-01; gemini-3.6-flash is
# Google's stated replacement. Check your real quota at
# https://aistudio.google.com/rate-limit — it is per project, not per key.
GEMINI_MODEL=gemini-3.6-flash

# Used when the model above returns 503 "high demand" on every retry. Google's
# capacity varies per model — on 2026-11-05 gemini-3.6-flash was intermittently
# overloaded while this one stayed up. Set it equal to GEMINI_MODEL to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Prior conversation turns sent to Gemini for context.
AI_CONTEXT_MESSAGE_COUNT=20

# Daily caps. The free tier is shared across ALL users of the app, so without
# these one person can exhaust the whole day's quota for everyone.
AI_DAILY_LIMIT_PER_USER=50
AI_DAILY_LIMIT_GLOBAL=500

# Every new registration is auto-joined to the workspace with this slug.
# SECURITY: anyone who signs up can then read that workspace's discussions and AI
# conversations. Development and demo only — leave UNSET in production, where
# joining should require an invitation.
DEFAULT_WORKSPACE_SLUG=kelola-demo
