{
  "name": "kelola-api",
  "version": "1.0.0",
  "description": "Kelola backend API — Express, Drizzle, Neon Postgres, Better Auth",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate:prod": "node dist/db/migrate.js"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@neon/config": "^1.10.1",
    "@neon/env": "^1.6.9",
    "better-auth": "^1.7.16",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1",
    "typescript": "^7.0.2",
    "word-extractor": "^1.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/word-extractor": "^1.0.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^3.2.4"
  }
}
